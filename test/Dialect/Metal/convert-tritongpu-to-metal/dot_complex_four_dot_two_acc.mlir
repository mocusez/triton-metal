    %bi_ptrs_26 = tt.addptr %bi_ptrs, %br_ptrs_19 : tensor<8x1x!tt.ptr<f32>, #blocked>, tensor<8x1xi32, #blocked> loc(#loc52)
    %bi_ptrs_27 = tt.broadcast %bi_ptrs_26 : tensor<8x1x!tt.ptr<f32>, #blocked> -> tensor<8x8x!tt.ptr<f32>, #blocked> loc(#loc52)
    %bi_ptrs_28 = tt.addptr %bi_ptrs_27, %br_ptrs_24 : tensor<8x8x!tt.ptr<f32>, #blocked>, tensor<8x8xi32, #blocked> loc(#loc52)
    %acc_i:6 = scf.for %_ = %c0_i32 to %c16_i32 step %c8_i32 iter_args(%a_ptrs_35 = %a_ptrs_15, %ai_ptrs_36 = %ai_ptrs_18, %br_ptrs_37 = %br_ptrs_25, %bi_ptrs_38 = %bi_ptrs_28, %acc_r = %cst_1, %acc_i_39 = %cst_1) -> (tensor<8x8x!tt.ptr<f32>, #blocked>, tensor<8x8x!tt.ptr<f32>, #blocked>, tensor<8x8x!tt.ptr<f32>, #blocked>, tensor<8x8x!tt.ptr<f32>, #blocked>, tensor<8x8xf32, #blocked>, tensor<8x8xf32, #blocked>)  : i32 {
