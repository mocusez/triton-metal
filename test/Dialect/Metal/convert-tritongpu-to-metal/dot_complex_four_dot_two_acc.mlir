    %br_ptrs_22 = tt.expand_dims %offs_n_8 {axis = 0 : i32} : tensor<8xi32, #ttg.slice<{dim = 0, parent = #blocked}>> -> tensor<1x8xi32, #blocked> loc(#loc51)
    %br_ptrs_23 = tt.broadcast %br_ptrs_21 : tensor<8x1x!tt.ptr<f32>, #blocked> -> tensor<8x8x!tt.ptr<f32>, #blocked> loc(#loc50)
