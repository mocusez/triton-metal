// RUN: env TRITON_METAL_SCALAR_DOT=1 triton-metal-opt --convert-tritongpu-to-metal %s | FileCheck %s
//
// Complex matmul correctness fallback for FFT-like kernels. The source loop
// carries four advancing pointers plus two f32 accumulators. Its body computes:
//   old_real + (dot(ar, br) - dot(ai, bi))
//   old_imag + (dot(ar, bi) + dot(ai, br))
// The Metal fallback proves that exact four-dot/two-accumulator structure and
// emits four scalar reductions before forming the two independent stores.
//
// CHECK-LABEL: metal.kernel complex_dot_kernel
// CHECK-COUNT-4: scf.for {{.*}} iter_args
// CHECK: metal.binary_exp {{.*}} subOp
// CHECK: metal.binary_exp {{.*}} addOp
// CHECK-COUNT-2: metal.store
// CHECK-NOT: tt.dot
// CHECK-NOT: ttg.convert_layout
//
#blocked = #ttg.blocked<{sizePerThread = [1, 1], threadsPerWarp = [4, 8], warpsPerCTA = [1, 1], order = [1, 0]}>
#loc = loc("/private/tmp/dump_complex_dot_ttgir.py":8:1)
#loc34 = loc("ar"(#loc))
#loc35 = loc("ai"(#loc))
#loc36 = loc("br"(#loc))
#loc37 = loc("bi"(#loc))
#loc38 = loc("cr"(#loc))
#loc39 = loc("ci"(#loc))
module attributes {"ttg.num-ctas" = 1 : i32, "ttg.num-warps" = 1 : i32, ttg.target = "cuda:80", "ttg.threads-per-warp" = 32 : i32} {
