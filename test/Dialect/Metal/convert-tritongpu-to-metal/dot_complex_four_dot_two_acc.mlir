    %a_ptrs = tt.expand_dims %offs_m_6 {axis = 1 : i32} : tensor<8xi32, #ttg.slice<{dim = 1, parent = #blocked}>> -> tensor<8x1xi32, #blocked> loc(#loc45)
    %a_ptrs_9 = arith.muli %a_ptrs, %cst_2 : tensor<8x1xi32, #blocked> loc(#loc45)
