    %a_ptrs_11 = tt.addptr %a_ptrs_10, %a_ptrs_9 : tensor<8x1x!tt.ptr<f32>, #blocked>, tensor<8x1xi32, #blocked> loc(#loc46)
    %a_ptrs_12 = tt.expand_dims %offs_m_4 {axis = 0 : i32} : tensor<8xi32, #ttg.slice<{dim = 0, parent = #blocked}>> -> tensor<1x8xi32, #blocked> loc(#loc47)
